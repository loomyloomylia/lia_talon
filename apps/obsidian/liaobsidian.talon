app: obsidian
hostname: LiaBox2
-
tag(): user.unprefixed_numbers
tag(): user.code_operators_math
tag(): user.code_operators_math_comparison
tag(): user.parrot_active

grid:
    key("ctrl-\'")

objects:
    key("alt-s")

next:
    user.move_cursor_to_next_snippet_stop()

next one:
    user.move_cursor_to_next_snippet_stop()
    key("1")

x|ex:
    key("x")

why|y:
    key("y")

prime:
    key("'")

plus or minus:
    insert("±")

group:
    key("ctrl-g")

ungroup:
    key("ctrl-shift-g")

lock|unlock:
    key("ctrl-shift-l")

slash sub drawings:
    insert("/Subdrawings")